    <!-- JavaScript -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Elements
        const navbar = document.querySelector('.navbar');
        const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
        const navMenu = document.querySelector('.nav-menu');
        const userProfile = document.getElementById('userProfile');
        const userDropdown = document.getElementById('userDropdown');
        const modal = document.getElementById('quickViewModal');
        const closeModal = document.getElementById('closeModal');
        const toastContainer = document.querySelector('.toast-container');
        const cartCountElement = document.getElementById('cart-count');
        
        // Show/Hide mobile menu
        mobileMenuToggle.addEventListener('click', function() {
            navMenu.classList.toggle('active');
            this.innerHTML = navMenu.classList.contains('active') 
                ? '<i class="fas fa-times"></i>' 
                : '<i class="fas fa-bars"></i>';
        });
        
        // Show/Hide user dropdown
        userProfile.addEventListener('click', function(e) {
            e.stopPropagation();
            userDropdown.classList.toggle('active');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function() {
            userDropdown.classList.remove('active');
        });
        
        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
        
        // Create toast notification
        function createToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icon = type === 'success' 
                ? '<i class="fas fa-check-circle toast-icon"></i>' 
                : '<i class="fas fa-exclamation-circle toast-icon"></i>';
            
            toast.innerHTML = `
                ${icon}
                <div class="toast-content">
                    <p class="toast-message">${message}</p>
                </div>
                <button class="toast-close">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            toastContainer.appendChild(toast);
            
            // Show toast
            setTimeout(() => {
                toast.classList.add('show');
            }, 10);
            
            // Auto dismiss after 3 seconds
            const dismissTimeout = setTimeout(() => {
                dismissToast(toast);
            }, 3000);
            
            // Close button
            toast.querySelector('.toast-close').addEventListener('click', () => {
                clearTimeout(dismissTimeout);
                dismissToast(toast);
            });
            
            return toast;
        }
        
        // Dismiss toast notification
        function dismissToast(toast) {
            toast.classList.remove('show');
            setTimeout(() => {
                toast.remove();
            }, 300);
        }
        
        // Update cart count with animation
        function updateCartCount(count) {
            cartCountElement.textContent = count;
            cartCountElement.classList.add('cart-pulse');
            setTimeout(() => {
                cartCountElement.classList.remove('cart-pulse');
            }, 500);
        }
        
        // Add to Cart functionality
        document.querySelectorAll('.btn-add-cart').forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.id;
                const originalText = this.innerHTML;
                
                // Show loading state
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
                this.disabled = true;
                
                fetch('add-to-cart.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `product_id=${productId}&quantity=1`
                })
                .then(response => response.json())
                .then(data => {
                    // Reset button state
                    this.innerHTML = originalText;
                    this.disabled = false;
                    
                    if (data.success) {
                        updateCartCount(data.cartCount);
                        createToast('Product added to your cart!');
                    } else {
                        createToast(data.message || 'Failed to add product to cart', 'error');
                    }
                })
                .catch(error => {
                    // Reset button state
                    this.innerHTML = originalText;
                    this.disabled = false;
                    createToast('An error occurred. Please try again.', 'error');
                });
            });
        });
        
        // Quick View functionality
        document.querySelectorAll('.btn-view, .btn-quick-view').forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.id;
                
                // Show loading state for btn-view
                if (this.classList.contains('btn-view')) {
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
                    this.disabled = true;
                    
                    // Reset after a delay
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.disabled = false;
                    }, 1000);
                }
                
                fetch(`get_product.php?id=${productId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            showProductModal(data.product);
                        } else {
                            createToast(data.message || 'Failed to load product details', 'error');
                        }
                    })
                    .catch(error => {
                        createToast('An error occurred. Please try again.', 'error');
                    });
            });
        });
        
        // Wishlist functionality
        document.querySelectorAll('.btn-wishlist').forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                const productId = this.dataset.id;
                
                // Toggle heart icon
                const icon = this.querySelector('i');
                const isInWishlist = icon.classList.contains('fas');
                
                if (isInWishlist) {
                    icon.classList.replace('fas', 'far');
                    createToast('Product removed from your wishlist');
                } else {
                    icon.classList.replace('far', 'fas');
                    icon.style.color = '#f44336';
                    createToast('Product added to your wishlist');
                }
                
                // Here you would also send an AJAX request to update the wishlist in the database
            });
        });
        
        // Show product modal
        function showProductModal(product) {
            // Create product specs data
            const specsData = [
                { label: 'Brand', value: product.brand || product.category },
                { label: 'Availability', value: product.stock > 0 ? 'In Stock' : 'Out of Stock' },
                { label: 'SKU', value: `SKU-${product.id}` },
                { label: 'Size', value: product.size || 'Multiple Sizes' }
            ];
            
            const specs = specsData.map(spec => `
                <div class="spec-item">
                    <span class="spec-label">${spec.label}</span>
                    <span class="spec-value">${spec.value}</span>
                </div>
            `).join('');
            
            // Calculate discount percentage if applicable
            const hasDiscount = product.original_price && product.original_price > product.price;
            const discountPercentage = hasDiscount ? 
                Math.round(100 - (product.price * 100 / product.original_price)) : 0;
            
            // Create price HTML
          // Create price HTML
let priceHTML = `₱${parseFloat(product.price).toFixed(2)}`;
if (hasDiscount) {
    priceHTML += `
        <span class="original-price">₱${parseFloat(product.original_price).toFixed(2)}</span>
        <span class="discount-badge">${discountPercentage}% OFF</span>
    `;
}
            
            // Create modal content
            const content = `
                <div class="product-view">
                    <div class="product-view-image">
                        <img src="${product.image_path}" alt="${product.name}">
                    </div>
                    <div class="product-view-details">
                        <div class="product-view-category">${product.category}</div>
                        <h2 class="product-view-name">${product.name}</h2>
                        <div class="product-view-price">${priceHTML}</div>
                        <p class="product-view-description">
                            ${product.description || 'No description available for this product. Please check back later for updates.'}
                        </p>
                        <div class="product-specs">${specs}</div>
                        <div class="quantity-control">
                            <span class="quantity-label">Quantity:</span>
                            <div class="quantity-buttons">
                                <button class="quantity-btn minus" aria-label="Decrease quantity">-</button>
                                <input type="number" class="quantity-input" id="productQuantity" value="1" min="1" max="${product.stock}">
                                <button class="quantity-btn plus" aria-label="Increase quantity">+</button>
                            </div>
                        </div>
                        <div class="product-view-actions">
                            <button class="btn-add-cart-modal" data-id="${product.id}">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="btn-wishlist" data-id="${product.id}" aria-label="Add to wishlist">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            // Set content and show modal
            document.getElementById('productDetails').innerHTML = content;
            modal.style.display = 'block';
            modal.classList.add('show');
            
            // Quantity controls
            const quantityInput = document.getElementById('productQuantity');
            const minusBtn = document.querySelector('.quantity-btn.minus');
            const plusBtn = document.querySelector('.quantity-btn.plus');
            
            minusBtn.addEventListener('click', () => {
                if (quantityInput.value > 1) {
                    quantityInput.value = parseInt(quantityInput.value) - 1;
                }
            });

            plusBtn.addEventListener('click', () => {
                if (quantityInput.value < parseInt(quantityInput.max)) {
                    quantityInput.value = parseInt(quantityInput.value) + 1;
                }
            });

            // Add to cart from modal
            document.querySelector('.btn-add-cart-modal').addEventListener('click', function() {
                const productId = this.dataset.id;
                const quantity = quantityInput.value;
                const originalText = this.innerHTML;

                // Show loading state
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
                this.disabled = true;

                fetch('add-to-cart.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `product_id=${productId}&quantity=${quantity}`
                })
                .then(response => response.json())
                .then(data => {
                    // Reset button state
                    this.innerHTML = originalText;
                    this.disabled = false;

                    if (data.success) {
                        updateCartCount(data.cartCount);
                        createToast(`${quantity} item(s) added to cart!`);
                        modal.style.display = 'none';
                    } else {
                        createToast(data.message || 'Failed to add item to cart', 'error');
                    }
                })
                .catch(error => {
                    // Reset button state
                    this.innerHTML = originalText;
                    this.disabled = false;
                    createToast('An error occurred. Please try again.', 'error');
                });
            });
        }

        // Close modal functionality
        closeModal.addEventListener('click', () => {
            modal.style.display = 'none';
            modal.classList.remove('show');
        });

        // Close modal when clicking outside
        window.addEventListener('click', (event) => {
            if (event.target === modal) {
                modal.style.display = 'none';
                modal.classList.remove('show');
            }
        });
    });
    </script>
