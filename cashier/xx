<?php
session_start();
include '../includes/auth.php';
include '../includes/db_connect.php';

// Redirect if not logged in as customer
if (!isLoggedIn() || $_SESSION['role'] !== 'customer') {
    header("Location: ../auth/login.php");
    exit();
}

$customerName = $_SESSION['name'] ?? 'Customer';

// Get categories for filter
$categoriesQuery = "SELECT DISTINCT category FROM products WHERE stock > 0";
$categoriesResult = $conn->query($categoriesQuery);
$categories = [];
if ($categoriesResult) {
    while ($row = $categoriesResult->fetch_assoc()) {
        $categories[] = $row['category'];
    }
}

// Handle category filter
$categoryFilter = '';
if (isset($_GET['category']) && $_GET['category'] !== 'all') {
    $category = $conn->real_escape_string($_GET['category']);
    $categoryFilter = " AND category = '$category'";
}

// Fetch products from database
$productsQuery = "SELECT * FROM products WHERE stock > 0" . $categoryFilter . " ORDER BY created_at DESC";
$productsResult = $conn->query($productsQuery);

// Get cart count
$userId = $_SESSION['user_id'];
$cartCountQuery = "SELECT SUM(quantity) as count FROM cart WHERE user_id = $userId";
$cartCountResult = $conn->query($cartCountQuery);
$cartCount = 0;
if ($cartCountResult && $row = $cartCountResult->fetch_assoc()) {
    $cartCount = $row['count'] ?: 0;
}
